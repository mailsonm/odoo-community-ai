<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_ai_assistant" model="ir.module.category">
            <field name="name">Artificial Intelligence</field>
            <field name="description">Manage access to AI Assistant, Copilot and LLM providers.</field>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_ai_assistant" model="res.groups.privilege">
            <field name="name">AI Assistant &amp; Copilot</field>
            <field name="category_id" ref="module_category_ai_assistant"/>
        </record>

        <record id="group_ai_user" model="res.groups">
            <field name="name">AI Assistant - User</field>
            <field name="privilege_id" ref="privilege_ai_assistant"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ai_admin" model="res.groups">
            <field name="name">AI Assistant - Administrator</field>
            <field name="privilege_id" ref="privilege_ai_assistant"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('odoo_community_ai.group_ai_admin'))]"/>
        </record>
    </data>
</odoo>
