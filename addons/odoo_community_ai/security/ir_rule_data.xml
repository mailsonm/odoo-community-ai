<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_llm_conversation_personal" model="ir.rule">
            <field name="name">Personal AI Conversations Only</field>
            <field name="model_id" ref="model_llm_conversation"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <record id="rule_llm_conversation_admin" model="ir.rule">
            <field name="name">All AI Conversations (Administrator)</field>
            <field name="model_id" ref="model_llm_conversation"/>
            <field name="groups" eval="[(4, ref('group_ai_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_llm_message_personal" model="ir.rule">
            <field name="name">Personal AI Messages Only</field>
            <field name="model_id" ref="model_llm_message"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_llm_message_admin" model="ir.rule">
            <field name="name">All AI Messages (Administrator)</field>
            <field name="model_id" ref="model_llm_message"/>
            <field name="groups" eval="[(4, ref('group_ai_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
