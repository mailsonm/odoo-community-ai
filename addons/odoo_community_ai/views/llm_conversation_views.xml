<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_llm_conversation_list" model="ir.ui.view">
        <field name="name">llm.conversation.list</field>
        <field name="model">llm.conversation</field>
        <field name="arch" type="xml">
            <list string="AI Conversations">
                <field name="is_favorite" widget="boolean_toggle" string="Favorite"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="write_date" string="Last Activity"/>
            </list>
        </field>
    </record>

    <record id="view_llm_conversation_form" model="ir.ui.view">
        <field name="name">llm.conversation.form</field>
        <field name="model">llm.conversation</field>
        <field name="arch" type="xml">
            <form string="AI Conversation">
                <header>
                    <button name="action_toggle_favorite" string="Toggle Favorite" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="is_favorite"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Timestamp"/>
                                    <field name="role" widget="badge" decoration-info="role == 'user'" decoration-success="role == 'assistant'"/>
                                    <field name="content"/>
                                    <field name="tokens_used" string="Estimated Tokens"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_llm_conversation" model="ir.actions.act_window">
        <field name="name">Conversation History</field>
        <field name="res_model">llm.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
