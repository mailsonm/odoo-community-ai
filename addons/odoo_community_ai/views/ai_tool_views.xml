<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_tool_list" model="ir.ui.view">
        <field name="name">ai.tool.list</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <list string="AI Tools (OCA Standard)">
                <field name="name"/>
                <field name="code"/>
                <field name="category" widget="badge"/>
                <field name="model_name"/>
                <field name="method_name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_tool_form" model="ir.ui.view">
        <field name="name">ai.tool.form</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <form string="AI Tool">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tool Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="method_name"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_tool" model="ir.actions.act_window">
        <field name="name">AI Tools Registry</field>
        <field name="res_model">ai.tool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
